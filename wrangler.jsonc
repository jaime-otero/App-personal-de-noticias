{
  // Cloudflare Worker: serves the static PWA in web/ and the profile-sync API (src/worker.js).
  "name": "mi-diario",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Launches the news update every 30 min (see planRun in src/worker.js); needs the
  // GITHUB_DISPATCH_TOKEN secret. GITHUB_REPO is the repo whose workflow it runs.
  "triggers": { "crons": ["17,47 * * * *"] },
  // Keep the Worker's logs (dispatch ok / errors) in the dashboard: Workers & Pages → mi-diario → Logs.
  "observability": { "enabled": true },
  "vars": { "GITHUB_REPO": "jaime-otero/App-personal-de-noticias" },
  // Keep the variables added in the dashboard (e.g. INVITES as plain text, so the codes can be
  // read there); without this every deploy would delete them. The repo is public: never put
  // INVITES here.
  "keep_vars": true,
  "kv_namespaces": [{ "binding": "PROFILES", "id": "84922554d2ce4fd8abd94c851851ede9" }]
}
